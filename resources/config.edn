;; See https://github.com/juxt/aero.
;; #biff/env and #biff/secret load values from the process environment and
;; from the root config.env file.

{:biff.config/system-properties
 {"clojure.main.report"
  "stderr"

  "clojure.tools.logging.factory"
  "clojure.tools.logging.impl/slf4j-factory"}

 ;; =============================================================================
 ;; HTTP / Ring
 ;; =============================================================================

 :biff.ring/base-url
 #or [#biff/env BASE_URL
      #profile
       {:prod
        #join ["https://"
               #biff/env DOMAIN]

        :default
        #join ["http://localhost:"
               #ref [:biff.ring/port]]}]

 :biff.ring/host
 #or [#biff/env HOST
      #profile
       {:dev
        "0.0.0.0"

        :default
        "localhost"}]

 :biff.ring/port
 #long #or [#biff/env PORT
            "8080"]

 :biff.ring/secure
 #boolean #or [#biff/env SECURE
               #profile
                {:dev
                 "false"

                 :default
                 "true"}]

 :biff.ring/cookie-secret
 #biff/secret COOKIE_SECRET

 ;; HumanHelp currently terminates TLS outside the Aleph process.
 :biff.ring/ssl-redirect
 false

 ;; =============================================================================
 ;; XTDB
 ;; =============================================================================

 :biff.xtdb/storage
 #keyword #or [#biff/env PROD_XTDB_STORAGE
               "local"]

 :biff.xtdb/storage-bucket
 #biff/env XTDB_STORAGE_BUCKET

 :biff.xtdb/storage-endpoint
 #biff/env XTDB_STORAGE_ENDPOINT

 :biff.xtdb/storage-access-key
 #biff/env XTDB_STORAGE_ACCESS_KEY

 :biff.xtdb/storage-secret-key
 #biff/secret XTDB_STORAGE_SECRET_KEY

 ;; =============================================================================
 ;; HumanHelp integrations
 ;; =============================================================================

 ;; Retained during migration. Remove this key and JWT_SECRET after confirming
 ;; that no HumanHelp-owned authentication flow still consumes it.
 :biff/jwt-secret
 #biff/secret JWT_SECRET

 :mailersend/api-key
 #biff/secret MAILERSEND_API_KEY

 :mailersend/from
 #biff/env MAILERSEND_FROM

 :mailersend/reply-to
 #biff/env MAILERSEND_REPLY_TO

 :recaptcha/secret-key
 #biff/secret RECAPTCHA_SECRET_KEY

 :recaptcha/site-key
 #biff/env RECAPTCHA_SITE_KEY

 ;; This remains a plain string because wrap-dev-load-token currently compares
 ;; it directly rather than forcing a Biff secret delay.
 :net.humanhelp.load/dev-token
 #biff/env GESSOTEST_LOAD_TOKEN

 ;; =============================================================================
 ;; Biff development and deployment tasks
 ;; =============================================================================

 :biff.tasks/main-ns
 net.humanhelp

 :biff.tasks/nrepl-port
 #long #or [#biff/env NREPL_PORT
            "7888"]

 :biff.tasks/domain
 #or [#biff/env SERVER
      #biff/env DOMAIN]

 :biff.tasks/deployment-name
 "humanhelp"

 :biff.tasks/css-output
 "target/resources/public/css/main.css"

 :biff.tasks/deploy-untracked-files
 [#ref [:biff.tasks/css-output]

  {:src
   "config.prod.env"

   :dest
   "config.env"}]

 :biff.tasks/tailwind-version
 "4.3.0"}
