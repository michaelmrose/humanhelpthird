{:paths ["src" "resources"]

 :tasks
 {:requires ([babashka.deps :as deps]
             [babashka.fs :as fs]
             [clojure.string :as str])

  :init
  (do
    (def remote-gesso-deps
      '{:deps
        {michaelmrose/gesso
         {:git/url "https://github.com/michaelmrose/gesso.git"
          :git/tag "v0.2.1"
          :git/sha "1e6e2fe043bde3e0368420ce4aa41ade450df959"}}})

    (def local-gesso-deps
      '{:deps
        {michaelmrose/gesso
         {:local/root "../gesso"}}})

    (defn gesso-mode
      [args]
      (let [args (vec args)]
        (cond
          (empty? args)
          :remote

          (= ["local"] args)
          :local

          :else
          (throw
           (ex-info
            "Expected no argument or the single argument: local"
            {:args  args
             :usage ["bb themes [local]"
                     "bb browser [local]"
                     "bb test:browser [local]"
                     "bb dev [local]"]})))))

    (defn add-gesso!
      [mode]
      (case mode
        :remote
        (do
          (println "Using pinned remote Gesso v0.2.1.")
          (deps/add-deps remote-gesso-deps))

        :local
        (do
          (println "Using local Gesso from ../gesso.")
          (deps/add-deps local-gesso-deps))))

    (defn dir?
      [path]
      (and path
           (fs/exists? path)
           (fs/directory? path)))

    (def browser-artifact-path
      "target/resources/public/js/gesso-live.js")

    (def remote-browser-build-sdeps
      "{:deps {org.clojure/clojurescript {:mvn/version \"1.12.145\"}}}")

    (def local-browser-build-sdeps
      "{:deps {org.clojure/clojurescript {:mvn/version \"1.12.145\"}
               michaelmrose/gesso {:local/root \"../gesso\"}}}")

    (def browser-realization-options-var
      'net.humanhelp.example.browser-realization/realization-options)

    (def browser-build-expression
      (str
       "(require '[gesso.live.browser.build :as browser-build] "
       "'[net.humanhelp.example.application-preflight :as application-preflight]) "
       "(let [artifact-path \"" browser-artifact-path "\" "
       "receipt (browser-build/build-application-artifact! "
       "application-preflight/browser-declaration "
       "artifact-path "
       "{:realization-options-var "
       "'" browser-realization-options-var "})] "
       "(println \"HumanHelp browser artifact: PASS\") "
       "(prn {:artifact-path artifact-path "
       ":receipt-path (browser-build/receipt-path artifact-path) "
       ":artifact (:artifact receipt) "
       ":stamp (:stamp receipt)}))"))

    (defn clojure-cli
      []
      (or
       (some-> (fs/which "clojure") str)
       (some-> (fs/which "clj") str)
       (throw
        (ex-info
         "HumanHelp browser builds require the Clojure CLI on PATH."
         {}))))

    (defn build-browser!
      [mode]
      (let [sdeps
            (case mode
              :remote remote-browser-build-sdeps
              :local local-browser-build-sdeps)]
        (println
         (if (= :local mode)
           "Building HumanHelp browser artifact with local ../gesso."
           "Building HumanHelp browser artifact with pinned remote Gesso."))
        ;; Inject local Gesso directly through -Sdeps instead of relying on the
        ;; :local-gesso alias. tools.deps may otherwise resolve the base pinned
        ;; git dependency before applying the alias in a clean cache.
        (shell
         (clojure-cli)
         "-Sdeps" sdeps
         "-M"
         "-e" browser-build-expression)
        mode))

    (defn build-themes!
      [args]
      (let [mode (gesso-mode args)]
        (add-gesso! mode)

        (let [gesso-path
              (-> (with-out-str
                    ((requiring-resolve 'gesso.build.find-path/-main)
                     "gesso"))
                  str/trim)

              ;; Accept any of these from gesso.build.find-path:
              ;;   repo root:  .../gesso
              ;;   src root:   .../gesso/src
              ;;   ns dir:     .../gesso/src/gesso
              candidate-src-roots
              (let [p           gesso-path
                    parent      (some-> p fs/parent str)
                    grandparent (some-> p fs/parent fs/parent str)]
                [(when (dir? (str p "/gesso"))
                   p)
                 (when (dir? (str p "/src/gesso"))
                   (str p "/src"))
                 (when (dir? (str parent "/gesso"))
                   parent)
                 (when (dir? (str grandparent "/src/gesso"))
                   (str grandparent "/src"))])

              gesso-src-root
              (first (filter dir? candidate-src-roots))

              gesso-components-dir
              (when gesso-src-root
                (str gesso-src-root "/gesso/components"))]

          (when-not gesso-src-root
            (throw
             (ex-info
              "Could not locate Gesso source root from gesso.build.find-path output."
              {:gesso-path          gesso-path
               :candidate-src-roots candidate-src-roots})))

          (when-not (dir? gesso-components-dir)
            (throw
             (ex-info
              "Could not locate Gesso component CSS directory."
              {:gesso-path           gesso-path
               :gesso-src-root       gesso-src-root
               :gesso-components-dir gesso-components-dir})))

          ((requiring-resolve 'gesso.build.themes/build!)
           {:input-dir   "resources/themes"
            :output-file "resources/public/gesso/app-themes.css"
            :component-css-dirs
            [gesso-components-dir
             "src/net/humanhelp/components"
             "src/net/humanhelp/example/components"
             "src/net/humanhelp/site/components"]}))

        mode))

    (defn run-browser-acceptance!
      [args]
      (let [mode  (gesso-mode args)
            sdeps (case mode
                    :remote remote-browser-build-sdeps
                    :local  local-browser-build-sdeps)]
        ;; Browser acceptance must run against the exact artifact generated from
        ;; the same dependency mode.  In local mode, inject ../gesso through
        ;; -Sdeps for the test JVM as well as the build JVM; this avoids a clean
        ;; tools.deps cache resolving the pinned remote Gesso before the
        ;; :local-gesso override can take effect.
        (build-browser! mode)
        (println
         (if (= :local mode)
           "Running HumanHelp Chromium acceptance with local ../gesso."
           "Running HumanHelp Chromium acceptance with pinned remote Gesso."))
        (shell
         (clojure-cli)
         "-Sdeps" sdeps
         "-M:browser-test"
         "-m" "net.humanhelp.example.chromium-acceptance")
        mode))

    (defn start-dev!
      [args]
      (let [mode (build-themes! args)]
        (build-browser! mode)
        (case mode
          :remote
          (shell "clj" "-M:dev" "dev")

          :local
          (shell "clj" "-M:local-gesso:dev" "dev")))))

  to-template
  {:doc "Regenerate the deps-new template project from this repo."
   :task
   (let [template-dir      "gesso-template-deps-new"
         source-primary-ns "humanehelp"
         template-name     "local/gesso-template-deps-new"]
     (shell "rm" "-rf" (str "../" template-dir))
     (shell "bb" "to-template.clj"
            template-dir
            source-primary-ns
            template-name))}

  new
  {:doc "Create a project from the sibling gesso-template-deps-new template. Usage: bb new TARGET-DIR PRIMARY-NS"
   :task
   (let [[target-dir primary-ns & more] *command-line-args*]
     (when (or (nil? target-dir)
               (nil? primary-ns)
               (seq more))
       (binding [*out* *err*]
         (println "Usage:")
         (println "  bb new TARGET-DIR PRIMARY-NS")
         (println)
         (println "Examples:")
         (println "  bb new ../gargle gargle")
         (println "  bb new ../humanhelp net.whatever"))
       (System/exit 1))

     (shell "clojure"
            "-Sdeps"
            "{:deps {local/template {:local/root \"../gesso-template-deps-new\"}}}"
            "-Tnew"
            "create"
            ":template"
            "local/gesso-template-deps-new"
            ":name"
            primary-ns
            ":target-dir"
            target-dir))}

  themes
  {:doc "Build theme CSS. Pass 'local' to use ../gesso instead of pinned remote Gesso."
   :task
   (build-themes! *command-line-args*)}

  browser
  {:doc "Build the exact stamped HumanHelp gesso-live.js. Pass 'local' to use ../gesso."
   :task
   (build-browser! (gesso-mode *command-line-args*))}

  dev
  {:doc "Build themes + exact browser artifact and start the dev server. Pass 'local' to use ../gesso."
   :task
   (start-dev! *command-line-args*)}

  test
  {:doc "Run the full HumanHelp test gate. Pass 'local' to test against ../gesso."
   :task
   (apply shell
          (into ["bb"
                 "script/humanhelp_test.clj"
                 "all"]
                *command-line-args*))}

  test:jvm
  {:doc "Run the HumanHelp JVM test gate. Pass 'local' to test against ../gesso. Included by `bb test`."
   :task
   (apply shell
          (into ["bb"
                 "script/humanhelp_test.clj"
                 "jvm"]
                *command-line-args*))}

  test:browser
  {:doc "Build the exact stamped HumanHelp browser artifact and run real Chromium acceptance. Pass 'local' to use ../gesso."
   :task
   (run-browser-acceptance! *command-line-args*)}

  test:integrity
  {:doc "Verify namespace/path integrity. Included by `bb test` and `bb test:jvm`."
   :task
   (shell "bb"
          "script/humanhelp_test.clj"
          "integrity")}}}
